; ZERO — 3D Disassembly Puzzle
; Godot 4.7 / Mobile renderer / Portrait 9:16

config_version=5

[application]

config/name="ZERO"
config/description="Disassemble to Discover"
run/main_scene="res://scenes/game/game.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.055, 0.094, 1)
boot_splash/show_image=false

[autoload]

Sfx="*res://scripts/audio/sfx.gd"
Haptics="*res://scripts/core/haptics.gd"
DebugFlags="*res://scripts/core/debug_flags.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.043, 0.055, 0.094, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
